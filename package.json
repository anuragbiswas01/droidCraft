{
  "name": "droidcraft",
  "version": "2.0.0",
  "description": "Minimalist, responsive Android screen controller supporting both legacy devices (ADB screencap) and modern devices (scrcpy)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend run build",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "keywords": [
    "android",
    "adb",
    "scrcpy",
    "screen-mirror",
    "controller",
    "react",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  }
}
